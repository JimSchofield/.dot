# /* vim: set filetype=sh : */

# location of .dot repo
DOT=~/.dot

#OS specific
if [ "$OSTYPE" = "linux-gnu" ]; then
    #Linux specific
    source $DOT/.profile.linux
fi

# Homebrew first: it prepends to PATH, so anything we want to win
# over brew-installed binaries must be exported *after* this line.
if [ -x /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
fi

# Prepend a directory to PATH only if it exists and isn't already there.
# Keeps PATH from collecting duplicates and dead entries across re-sourcing.
path_prepend() {
    [ -d "$1" ] || return 0
    case ":$PATH:" in
        *":$1:"*) ;;
        *) PATH="$1:$PATH" ;;
    esac
}

path_prepend "$HOME/.local/bin"
path_prepend "$HOME/bin"
path_prepend "$HOME/learning/lexical/_build/dev/package/lexical/bin"
path_prepend "/usr/local/go/bin"
export PATH

export EDITOR=nvim

# Let the terminal advertise its own capabilities. Hardcoding
# screen-256color outside tmux breaks truecolor and undercurl.
[ -n "$TMUX" ] && export TERM=screen-256color

# GENERAL
alias li="lsd -la"
alias tree="lsd -T --git-ignore"
alias q="exit"

#### FZF
# set fd as default for fzf
export FZF_DEFAULT_COMMAND='fd --type f --hidden'

# Search from ./
alias gfh='cd "$(fd . "./" --type d --hidden| fzf)"'

# GIT
alias gl="git pull"
alias gs="git status"
alias gss="git status -s"
alias gp="git push"
alias glog="git log --oneline"
alias gpf="git push --force-with-lease"
alias gca="git commit --amend"
alias unstage="git reset HEAD"
alias gc-="git checkout -"
alias master="git checkout master"
alias main="git checkout main"
alias gcd="git checkout develop"

alias whodis="git shortlog -sne --all"

# NVIM
alias n="nvim ."

source $DOT/fzf/fzf-completion.zsh
source $DOT/fzf/fzf-key-bindings.zsh

# Oxide
eval "$(zoxide init zsh)"

# cpp
alias mymake="clang++ -Wall -std=c++11";

# Source work specific profile if it exists.
# Last so work settings can override anything above.
WORK_ZPROFILE=~/.zprofile_work
[ -f "$WORK_ZPROFILE" ] && source "$WORK_ZPROFILE"

# Don't let the check above leave a nonzero $? sitting in a fresh shell.
true
