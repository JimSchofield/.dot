#!/usr/bin/env bash

# Tmux session manager using fzf for interactive selection.
# Lists sessions and attaches (or switches, if already inside tmux).

set -euo pipefail

if ! tmux has-session 2>/dev/null; then
  echo "No tmux sessions running." >&2
  exit 1
fi

# fzf exits nonzero when cancelled; that's not an error worth reporting.
TARGET=$(tmux list-sessions -F '#S' | fzf --prompt='session> ' --height=40% --reverse) || exit 0

# Attaching to an empty target grabs the wrong session, so bail out.
[ -n "$TARGET" ] || exit 0

# $TMUX is set by tmux itself; TERM_PROGRAM gets clobbered by the terminal.
if [ -n "${TMUX:-}" ]; then
  tmux switch-client -t "$TARGET"
else
  tmux attach-session -t "$TARGET"
fi
